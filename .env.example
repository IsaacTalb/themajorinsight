# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Cloudflare Zero Trust admin access (server-only)
# Team domain example: your-team.cloudflareaccess.com (not the application hostname).
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) Tag for the Access app protecting /admin*.
CLOUDFLARE_ACCESS_AUD=
# Only this normalized email may use the admin area after Access authentication.
MAJOR_INSIGHT_ADMIN_ALLOWED_EMAIL=

# Cloudflare project metadata
CLOUDFLARE_ACCOUNT_ID=73ed31f39f727488b12a24b51473ec13
CLOUDFLARE_D1_DATABASE_ID=e49a5931-a942-49c6-a51c-bd632112b1eb
CLOUDFLARE_WORKER_NAME=themajorinsight-worker
CLOUDFLARE_WORKER_URL=https://themajorinsight-worker.isaac-talb.workers.dev

# Worker authentication (set with `npx wrangler secret put WORKER_TOKEN`)
# Add the same value to Vercel only if the Next.js app calls protected Worker endpoints.
WORKER_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=73ed31f39f727488b12a24b51473ec13
R2_BUCKET_NAME=themajorinsight-media
R2_PUBLIC_BASE_URL=
# Server-only S3-compatible R2 credentials used by the Vercel-hosted Next.js upload routes.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Monetization (keep disabled until approved)
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_CONSENT_REQUIRED=true
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_AD_SLOT_ARTICLE_INTRO=
NEXT_PUBLIC_AD_SLOT_ARTICLE_MID=
NEXT_PUBLIC_AD_SLOT_ARTICLE_RELATED=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_HOME_SECTION=

# Optional email delivery; only required once Resend delivery is wired.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
